# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# chiave service_role: SOLO lato server, mai nel browser
SUPABASE_SERVICE_ROLE_KEY=

# --- AI (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=
# facoltativo: modello Claude da usare (predefinito claude-opus-5-5)
# AI_MODEL=claude-opus-5-5

# --- WhatsApp tramite Callbell (attuale fornitore) ---
# La chiave API si inserisce per ogni sede in Impostazioni sede; qui solo un valore predefinito facoltativo
# CALLBELL_API_TOKEN=

# --- WhatsApp Business Cloud API diretta di Meta (alternativa a Callbell) ---
# token scelto da voi, da inserire anche in Meta quando configurate il webhook
WHATSAPP_VERIFY_TOKEN=
# App Secret dell'app Meta (serve a verificare che i messaggi arrivino davvero da Meta)
WHATSAPP_APP_SECRET=
# token permanente del System User; ogni sede può averne uno proprio (Impostazioni sede)
WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_API_VERSION=v23.0
# secondi di attesa per raggruppare più messaggi consecutivi del cliente (millisecondi)
# WHATSAPP_ATTESA_MS=8000

# --- Generale ---
NEXT_PUBLIC_NOME_STUDIO=IOSTRANIERO
NEXT_PUBLIC_APP_URL=https://gestionale.vostrodominio.it
